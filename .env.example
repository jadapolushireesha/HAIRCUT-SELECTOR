# Haircut Selector - Environment Secrets Template
# Copy this file to .env or .env.local for local development.
# NEVER commit your actual .env or .env.local file to version control.

# Optional API Base URL
VITE_API_BASE_URL=

# Optional AI / Face Detection API Key
VITE_API_KEY=

# Require API Key in production mode (true/false)
VITE_REQUIRE_API_KEY=false

# Analytics feature toggle (true/false)
VITE_ENABLE_ANALYTICS=false
